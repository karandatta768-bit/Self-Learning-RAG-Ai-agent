# Local Ollama model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2

# Embeddings and vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORSTORE_DIR=./vectorstore
EXPERIENCE_TOP_K=5
KNOWLEDGE_TOP_K=5
MEMORY_MIN_SIM=0.35

# Decision thresholds
AUTO_THRESHOLD=0.80
REVIEW_THRESHOLD=0.60
MAX_RETRIES=2

# Tools
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TIMEOUT=10
TOOL_TIMEOUT=15

# Paths
DATA_DIR=./data
KNOWLEDGE_DIR=./data/knowledge
EXPERIENCES_FILE=./data/experiences/episodes.jsonl
STRATEGY_FILE=./data/experiences/strategies.json
